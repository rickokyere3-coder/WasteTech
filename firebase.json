{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "max-age=300" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "max-age=60" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
